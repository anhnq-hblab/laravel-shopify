FROM php:8.2-cli

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libsqlite3-dev \
    libonig-dev \
    libxml2-dev \
    curl \
    && docker-php-ext-install zip pdo pdo_sqlite mbstring exif pcntl bcmath

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Create fresh Laravel 10 project
RUN composer create-project laravel/laravel:^10.0 test-app --prefer-dist

WORKDIR /app/test-app

# Install local package
COPY ./laravel-shopify /packages/laravel-shopify
RUN composer config repositories.local '{"type": "path", "url": "/packages/laravel-shopify"}'
RUN composer require kyon147/laravel-shopify:@dev

# Publish config
RUN php artisan vendor:publish --provider="Osiset\ShopifyApp\ShopifyAppProvider" --tag="shopify-config"

CMD ["tail", "-f", "/dev/null"]
